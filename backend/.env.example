APP_ENV=production
HOST=0.0.0.0
PORT=5050
CORS_ORIGINS=https://your-frontend.example
MAX_CONTENT_LENGTH=262144000
MAX_METADATA_BYTES=16384
SECURITY_HEADERS_ENABLED=true
EXPOSE_METADATA_HEADER=false
NOIR_WORKER_ENABLED=false
NOIR_PROOF_TIMEOUT_SECONDS=180
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Proof registration authentication
# Set REGISTER_API_KEY to require a Bearer token on POST /api/proofs/register.
# Leave unset to allow unauthenticated access (development only).
REGISTER_API_KEY=your-strong-random-key-here
# Optional ISO 8601 expiry datetime for the key.  Omit to never expire.
# REGISTER_API_KEY_EXPIRES=2027-01-01T00:00:00Z
