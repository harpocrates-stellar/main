    {
      "name": "valid-multi-level-lineage",
      "description": "A derivative whose ancestors all resolve to valid registered originals.",
      "input": {
        "outputDigest": "root_digest",
        "lineage": {
          "root_digest": {
            "parentProofIds": ["mid1_digest", "mid2_digest"],
            "parentCommitments": ["c1", "c2"],
            "manifestDigest": "m_root",
            "actor": "GACTOR",
            "operationType": "compose",
            "outputDigest": "root_digest",
            "depth": 2
          },
          "mid1_digest": {
            "parentProofIds": ["leaf1_proof", "leaf2_proof"],
            "parentCommitments": ["c3", "c4"],
            "manifestDigest": "m_mid1",
            "actor": "GACTOR",
            "operationType": "crop",
            "outputDigest": "mid1_digest",
            "depth": 1
          },
          "mid2_digest": {
            "parentProofIds": ["leaf3_proof"],
            "parentCommitments": ["c5"],
            "manifestDigest": "m_mid2",
            "actor": "GACTOR",
            "operationType": "blur",
            "outputDigest": "mid2_digest",
            "depth": 1
          }
        },
        "proofStatuses": {
          "leaf1_proof": "valid",
          "leaf2_proof": "valid",
          "leaf3_proof": "valid"
        }
      },
      "expected": {
        "exitCode": 0,
        "success": true,
        "failureReason": null,
        "counts": {
          "revokedCount": 0,
          "expiredCount": 0,
          "disputedCount": 0,
          "missingCount": 0,
          "incompleteCount": 0,
          "unavailableCount": 0
        },
        "cycleDetected": false,
        "stdout": "root_digest (derivative: compose)\n├── mid1_digest (derivative: crop)\n│   ├── leaf1_proof (original: valid)\n│   └── leaf2_proof (original: valid)\n└── mid2_digest (derivative: blur)\n    └── leaf3_proof (original: valid)"
      }
    },
