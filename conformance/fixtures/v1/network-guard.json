        "wallet": "test sdf network ; september 2015"
      },
      "op": "network_check",
      "tier": "required"
    },
    {
      "description": "Only the wallet value is trimmed; a padded contract passphrase never matches.",
      "expect": {
        "code": "network_mismatch",
        "detail": {
          "contract_network": "Test SDF Network ; September 2015 ",
