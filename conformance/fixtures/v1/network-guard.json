{
  "area": "network-guard",
  "cases": [
    {
      "description": "Identical passphrases.",
      "expect": {
        "ok": true,
        "output": {
          "match": true
        }
      },
      "id": "ng-pos-001-same",
      "input": {
        "contract": "Test SDF Network ; September 2015",
        "wallet": "Test SDF Network ; September 2015"
      },
      "op": "network_check",
      "tier": "required"
    },
    {
      "description": "The wallet value is trimmed before comparison.",
      "expect": {
        "ok": true,
        "output": {
          "match": true
        }
      },
      "id": "ng-pos-002-wallet-trimmed",
      "input": {
        "contract": "Test SDF Network ; September 2015",
        "wallet": "  Test SDF Network ; September 2015\n"
      },
      "op": "network_check",
      "tier": "required"
    },
    {
      "description": "U+00A0 is ECMAScript whitespace and is trimmed.",
      "expect": {
        "ok": true,
        "output": {
          "match": true
        }
      },
      "id": "ng-pos-003-nbsp-trimmed",
      "input": {
        "contract": "Test SDF Network ; September 2015",
        "wallet": "\u00a0Test SDF Network ; September 2015\u00a0"
      },
      "op": "network_check",
      "tier": "required"
    },
    {
      "description": "U+FEFF (ZWNBSP) is ECMAScript whitespace and IS trimmed; Python str.strip() does not trim it.",
      "expect": {
        "ok": true,
        "output": {
          "match": true
        }
      },
      "id": "ng-pos-004-bom-trimmed",
      "input": {
