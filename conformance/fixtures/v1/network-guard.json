        "wallet": "Test SDF Network ; September 2015\ufeff"
      },
      "op": "network_check",
      "tier": "required"
    },
    {
      "description": "Unicode Zs spaces are trimmed.",
      "expect": {
        "ok": true,
        "output": {
          "match": true
        }
      },
      "id": "ng-pos-005-ideographic-space-trimmed",
      "input": {
        "contract": "Test SDF Network ; September 2015",
        "wallet": "\u3000Test SDF Network ; September 2015\u2003"
      },
      "op": "network_check",
      "tier": "required"
    },
    {
      "description": "U+2028/U+2029 are line terminators and are trimmed.",
      "expect": {
        "ok": true,
        "output": {
          "match": true
        }
      },
      "id": "ng-pos-006-line-separators-trimmed",
      "input": {
        "contract": "Test SDF Network ; September 2015",
        "wallet": "\u2028Test SDF Network ; September 2015\u2029"
      },
      "op": "network_check",
      "tier": "required"
    },
    {
      "description": "null: wallet locked or unavailable.",
