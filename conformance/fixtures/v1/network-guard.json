      },
      "op": "network_check",
      "tier": "required"
    },
    {
      "description": "U+001F is not ECMAScript whitespace (Python str.strip() strips it).",
      "expect": {
        "code": "network_mismatch",
        "detail": {
          "contract_network": "Testnet",
          "wallet_network": "Test SDF Network ; September 2015\u001f"
        },
        "ok": false
      },
      "id": "ng-neg-017-unit-separator-is-not-js-whitespace",
      "input": {
