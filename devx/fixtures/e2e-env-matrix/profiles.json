{
  "schema_version": 1,
  "protocol": {
    "name": "harpocrates",
    "version": 1
  },
  "description": "Canonical end-to-end environment matrix profiles for CI. Profiles exercise public boundaries only; no real media, secrets, witnesses, or private keys.",
  "compatibility": {
    "api_version": 1,
    "rollback": "Remove .github/workflows/e2e-env-matrix.yml and devx/e2e_env_matrix* to disable; no stored evidence format changes.",
    "threat_model": "Matrix traffic is synthetic local Flask requests. Failure envelopes must never echo credentials, witnesses, proofs, or media bytes."
  },
  "profiles": [
    {
      "id": "testing-baseline",
      "group": "core",
      "expect_boot": true,
      "env": {
        "APP_ENV": "testing",
        "CORS_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
        "DATABASE_URL": "",
        "NOIR_WORKER_ENABLED": "false",
        "SECURITY_HEADERS_ENABLED": "true",
        "METRICS_ENABLED": "false",
        "EXPOSE_METADATA_HEADER": "false",
        "HARPOCRATES_RELEASE_ID": "harpocrates-1.0.0",
        "HARPOCRATES_RELEASE_NETWORK": "testnet",
        "MAX_JSON_BYTES": "1048576",
        "MAX_METADATA_BYTES": "16384"
      },
      "checks": [
        "health_ok",
        "ready_shape",
        "schemas_list",
        "register_malformed",
        "register_oversized",
        "sensitive_payload_redacted"
      ]
    },
    {
      "id": "development-wildcard-allowed",
      "group": "core",
      "expect_boot": true,
      "env": {
        "APP_ENV": "development",
        "CORS_ORIGINS": "*",
        "ALLOW_WILDCARD_CORS": "true",
        "DATABASE_URL": "",
        "NOIR_WORKER_ENABLED": "false",
        "SECURITY_HEADERS_ENABLED": "true",
        "METRICS_ENABLED": "false",
        "HARPOCRATES_RELEASE_ID": "harpocrates-1.0.0",
        "HARPOCRATES_RELEASE_NETWORK": "testnet",
        "MAX_JSON_BYTES": "1048576"
      },
      "checks": [
        "health_ok",
        "ready_shape",
        "register_malformed",
        "sensitive_payload_redacted"
      ]
    },
    {
      "id": "production-explicit-cors",
      "group": "core",
      "expect_boot": true,
      "env": {
        "APP_ENV": "production",
        "CORS_ORIGINS": "https://harpocrates.example",
        "DATABASE_URL": "",
        "NOIR_WORKER_ENABLED": "false",
        "SECURITY_HEADERS_ENABLED": "true",
        "METRICS_ENABLED": "true",
        "METRICS_TOKEN": "ci-matrix-metrics-token-not-a-secret",
        "EXPOSE_METADATA_HEADER": "false",
        "HARPOCRATES_RELEASE_ID": "harpocrates-1.0.0",
        "HARPOCRATES_RELEASE_NETWORK": "testnet",
        "MAX_JSON_BYTES": "65536"
      },
      "checks": [
        "health_ok",
        "ready_shape",
        "register_malformed",
        "register_oversized",
        "sensitive_payload_redacted",
        "metrics_token_not_leaked"
      ]
    },
    {
      "id": "production-wildcard-rejected",
      "group": "adversarial",
      "expect_boot": false,
      "expect_boot_error_substring": "Wildcard CORS",
      "env": {
        "APP_ENV": "production",
        "CORS_ORIGINS": "*",
        "DATABASE_URL": "",
        "NOIR_WORKER_ENABLED": "false"
      },
      "checks": []
    },
    {
      "id": "development-wildcard-without-flag",
      "group": "adversarial",
      "expect_boot": false,
      "expect_boot_error_substring": "ALLOW_WILDCARD_CORS",
      "env": {
        "APP_ENV": "development",
        "CORS_ORIGINS": "*",
        "DATABASE_URL": "",
        "NOIR_WORKER_ENABLED": "false"
      },
      "checks": []
    },
    {
      "id": "tight-json-boundary",
      "group": "adversarial",
      "expect_boot": true,
      "env": {
        "APP_ENV": "testing",
        "CORS_ORIGINS": "http://127.0.0.1:5173",
        "DATABASE_URL": "",
        "NOIR_WORKER_ENABLED": "false",
        "METRICS_ENABLED": "false",
        "MAX_JSON_BYTES": "256",
        "MAX_METADATA_BYTES": "128",
        "HARPOCRATES_RELEASE_ID": "harpocrates-1.0.0",
        "HARPOCRATES_RELEASE_NETWORK": "futurenet"
      },
      "checks": [
        "health_ok",
        "ready_shape",
        "register_oversized",
        "register_malformed",
        "unsupported_tier_stable"
      ]
    },
    {
      "id": "expired-unsupported-inputs",
      "group": "adversarial",
      "expect_boot": true,
      "env": {
        "APP_ENV": "testing",
        "CORS_ORIGINS": "http://localhost:5173",
        "DATABASE_URL": "",
        "NOIR_WORKER_ENABLED": "false",
        "METRICS_ENABLED": "false",
        "HARPOCRATES_RELEASE_ID": "harpocrates-1.0.0",
        "HARPOCRATES_RELEASE_NETWORK": "testnet"
      },
      "checks": [
        "health_ok",
        "register_unsupported_network_field_ignored_safely",
        "register_revoked_style_payload_rejected",
        "sensitive_payload_redacted"
      ]
    }
  ]
}
