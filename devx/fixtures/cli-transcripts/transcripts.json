{
  "protocol": "harpocrates-cli-transcripts",
  "schemaVersion": 1,
  "description": "Reproducible headless CLI command and lineage-verification transcripts using synthetic inputs without production endpoints or private media.",
  "cases": [
    {
      "id": "hash-stdin-json",
      "description": "Compute SHA-256 digest and byte count for synthetic stdin bytes in JSON format",
      "argv": [
        "hash",
        "--file",
        "-",
        "--output",
        "json"
      ],
      "stdin": "synthetic-evidence-frame-payload-v1\n",
      "expected": {
        "exitCode": 0,
        "stdout": "{\n  \"algorithm\": \"sha256\",\n  \"digest\": \"96295d42765994ca9feec7a23b2d87a3e80230077fa80a951abff4755e76e3ce\",\n  \"bytes\": 36\n}\n",
        "stderr": ""
      }
    },
    {
      "id": "manifest-from-metadata",
      "description": "Build deterministic canonical v2 proof manifest from synthetic metadata via stdin",
      "argv": [
        "manifest",
        "--input",
        "-",
        "--contract-id",
        "CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4",
        "--tx-hash",
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        "--video-hash",
        "fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210",
        "--format",
        "text"
      ],
      "stdin": "{\"protocol\":\"harpocrates\",\"version\":1,\"tier\":\"silent\",\"sourceHash\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"proofId\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\"timestamp\":\"2026-07-24T12:00:00.000Z\"}",
      "expected": {
        "exitCode": 0,
        "stdout": "{\"contractId\":\"CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4\",\"epoch\":0,\"metadataHash\":\"5fe555f982b37a0efda1c29a98dd9f8479dc014e9272641ebc2d6ee8f455a0c3\",\"network\":\"Test SDF Network ; September 2015\",\"proofId\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\"protocol\":\"harpocrates\",\"sourceHash\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"tier\":\"silent\",\"timestamp\":\"2026-07-24T12:00:00.000Z\",\"transactionRef\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\"verifierScope\":\"0\",\"version\":2,\"videoHash\":\"fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210\"}\n",
        "stderr": ""
      }
    },
    {
      "id": "verify-offline-pending",
      "description": "Offline manifest verification validates deployment bindings and returns exit 6 (pending)",
      "argv": [
        "verify",
        "--manifest",
        "-",
        "--contract-id",
        "CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4",
        "--offline",
        "--output",
        "json"
      ],
      "stdin": "{\"contractId\":\"CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4\",\"epoch\":0,\"metadataHash\":\"5fe555f982b37a0efda1c29a98dd9f8479dc014e9272641ebc2d6ee8f455a0c3\",\"network\":\"Test SDF Network ; September 2015\",\"proofId\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\"protocol\":\"harpocrates\",\"sourceHash\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"tier\":\"silent\",\"timestamp\":\"2026-07-24T12:00:00.000Z\",\"transactionRef\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\"verifierScope\":\"0\",\"version\":2,\"videoHash\":\"fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210\"}",
      "normalizeDynamicTimestamps": true,
      "expected": {
        "exitCode": 6,
        "stdout": "{\n  \"version\": 1,\n  \"verifiedAt\": \"<ISO-8601>\",\n  \"manifest\": {\n    \"contractId\": \"CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4\",\n    \"epoch\": 0,\n    \"metadataHash\": \"5fe555f982b37a0efda1c29a98dd9f8479dc014e9272641ebc2d6ee8f455a0c3\",\n    \"network\": \"Test SDF Network ; September 2015\",\n    \"proofId\": \"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\n    \"protocol\": \"harpocrates\",\n    \"sourceHash\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n    \"tier\": \"silent\",\n    \"timestamp\": \"2026-07-24T12:00:00.000Z\",\n    \"transactionRef\": \"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\n    \"verifierScope\": \"0\",\n    \"version\": 2,\n    \"videoHash\": \"fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210\"\n  },\n  \"transaction\": {\n    \"status\": \"pending\",\n    \"txHash\": \"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"\n  },\n  \"chainRecord\": null,\n  \"result\": \"pending\"\n}\n",
        "stderr": ""
      }
    },
    {
      "id": "verify-network-mismatch",
      "description": "Fail closed with exit 4 when manifest network disagrees with selected --network",
      "argv": [
        "verify",
        "--manifest",
        "-",
        "--contract-id",
        "CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4",
        "--network",
        "mainnet",
        "--offline"
      ],
      "stdin": "{\"contractId\":\"CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4\",\"epoch\":0,\"metadataHash\":\"5fe555f982b37a0efda1c29a98dd9f8479dc014e9272641ebc2d6ee8f455a0c3\",\"network\":\"Test SDF Network ; September 2015\",\"proofId\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\"protocol\":\"harpocrates\",\"sourceHash\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"tier\":\"silent\",\"timestamp\":\"2026-07-24T12:00:00.000Z\",\"transactionRef\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\"verifierScope\":\"0\",\"version\":2,\"videoHash\":\"fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210\"}",
      "expected": {
        "exitCode": 4,
        "stdout": "",
        "stderr": "harpocrates: network_mismatch\n"
      }
    },
    {
      "id": "verify-contract-mismatch",
      "description": "Fail closed with exit 5 when manifest contractId disagrees with selected --contract-id",
      "argv": [
        "verify",
        "--manifest",
        "-",
        "--contract-id",
        "CAAQCAIBAEAQCAIBAEAQCAIBAEAQCAIBAEAQCAIBAEAQCAIBAEAQC526",
        "--offline"
      ],
      "stdin": "{\"contractId\":\"CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4\",\"epoch\":0,\"metadataHash\":\"5fe555f982b37a0efda1c29a98dd9f8479dc014e9272641ebc2d6ee8f455a0c3\",\"network\":\"Test SDF Network ; September 2015\",\"proofId\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\"protocol\":\"harpocrates\",\"sourceHash\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"tier\":\"silent\",\"timestamp\":\"2026-07-24T12:00:00.000Z\",\"transactionRef\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\"verifierScope\":\"0\",\"version\":2,\"videoHash\":\"fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210\"}",
      "expected": {
        "exitCode": 5,
        "stdout": "",
        "stderr": "harpocrates: contract_mismatch\n"
      }
    },
    {
      "id": "verify-malformed-manifest",
      "description": "Reject malformed manifest JSON on stdin with exit 8 and privacy-safe stderr",
      "argv": [
        "verify",
        "--manifest",
        "-",
        "--contract-id",
        "CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4",
        "--offline"
      ],
      "stdin": "{\"protocol\":\"harpocrates\",\"broken\":",
      "expected": {
        "exitCode": 8,
        "stdout": "",
        "stderr": "harpocrates: invalid or unreadable manifest\n"
      }
    },
    {
      "id": "c2pa-export-unsigned",
      "description": "Export deterministic unsigned C2PA authenticity assertions from canonical manifest",
      "argv": [
        "c2pa",
        "--manifest",
        "-"
      ],
      "stdin": "{\"contractId\":\"CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4\",\"epoch\":0,\"metadataHash\":\"5fe555f982b37a0efda1c29a98dd9f8479dc014e9272641ebc2d6ee8f455a0c3\",\"network\":\"Test SDF Network ; September 2015\",\"proofId\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\"protocol\":\"harpocrates\",\"sourceHash\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"tier\":\"silent\",\"timestamp\":\"2026-07-24T12:00:00.000Z\",\"transactionRef\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\"verifierScope\":\"0\",\"version\":2,\"videoHash\":\"fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210\"}",
      "expected": {
        "exitCode": 0,
        "stdout": "{\"assertions\":[{\"data\":{\"actions\":[{\"action\":\"harpocrates.registered\",\"parameters\":{\"contractId\":\"CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4\",\"network\":\"Test SDF Network ; September 2015\",\"proofId\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\"tier\":\"silent\",\"transactionRef\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"},\"softwareAgent\":{\"name\":\"Harpocrates Protocol\"},\"when\":\"2026-07-24T12:00:00.000Z\"}],\"allActionsIncluded\":true},\"label\":\"c2pa.actions.v2\"},{\"data\":{\"alg\":\"sha256\",\"hash\":\"/ty6mHZUMhD+3LqYdlQyEP7cuph2VDIQ/ty6mHZUMhA=\",\"name\":\"video\",\"pad\":\" \"},\"label\":\"c2pa.hash.data\"},{\"data\":{\"contractId\":\"CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4\",\"epoch\":0,\"manifestHash\":\"7cc496f8fcdea0f47e195227cbc009df4d0ea95a7ff838cbd2ce5b0b81bc4d97\",\"manifestVersion\":2,\"metadataHash\":\"5fe555f982b37a0efda1c29a98dd9f8479dc014e9272641ebc2d6ee8f455a0c3\",\"network\":\"Test SDF Network ; September 2015\",\"proofId\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\"protocol\":\"harpocrates\",\"schemaVersion\":1,\"sourceHash\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"tier\":\"silent\",\"timestamp\":\"2026-07-24T12:00:00.000Z\",\"transactionRef\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\"verifierScope\":\"0\",\"videoHash\":\"fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210\"},\"label\":\"harpocrates.registry.v1\"},{\"data\":{\"exporter\":{\"name\":\"Harpocrates C2PA authenticity assertion exporter\",\"version\":\"1.0.0\"},\"input\":{\"manifestHash\":\"7cc496f8fcdea0f47e195227cbc009df4d0ea95a7ff838cbd2ce5b0b81bc4d97\",\"manifestVersion\":2,\"receiptVersion\":null},\"privacy\":\"public manifest and registry fields only; no media, secrets, witnesses, or keys\",\"schemaVersion\":1,\"unsigned\":true},\"label\":\"harpocrates.export.v1\"}],\"claim_generator\":\"harpocrates-cli/c2pa\",\"claim_generator_info\":[{\"name\":\"Harpocrates C2PA authenticity assertion exporter\",\"version\":\"1.0.0\"}],\"format\":\"application/json\"}\n",
        "stderr": ""
      }
    },
