        "proofId": "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd",
        "timestamp": "2026-09-25T06:37:59.964202Z",
        "rfc3161Chain": {
          "chain": [
            "base64-cert-1",
            "base64-cert-2"
          ],
          "trustRoots": [
            "base64-root"
          ],
          "genTime": "2023-09-26T06:37:59.964197Z",
          "expiresAt": "2024-09-25T06:37:59.964199Z"
        }
      },
      "expect": {
        "reject_code": "rfc3161_chain_expired",
        "must_not_log": [],
        "must_not_store": []
      }
    },
    {
