{
  "schemaVersion": 1,
  "category": "expired",
  "description": "Expired proof, timestamp, or credential vectors that must be rejected at the privacy boundary",
  "cases": [
    {
      "id": "exp-001-proof-expired",
      "description": "Proof past its validity window must be rejected",
      "input": {
        "protocol": "harpocrates",
        "version": 1,
        "tier": "silent",
        "sourceHash": "abababababababababababababababababababababababababababababababab",
        "proofId": "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd",
        "timestamp": "2026-09-25T06:37:59.964185Z",
        "validUntil": "2024-09-25T06:37:59.964165Z"
      },
      "expect": {
        "reject_code": "proof_expired",
        "must_not_log": [],
        "must_not_store": []
      }
    },
    {
      "id": "exp-002-timestamp-too-old",
