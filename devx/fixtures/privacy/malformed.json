          "proof": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.sensitive-jwt-token"
        }
      },
      "expect": {
        "reject_code": "sensitive_field_detected",
        "must_not_log": [
          "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.sensitive-jwt-token"
        ],
        "must_not_store": [
