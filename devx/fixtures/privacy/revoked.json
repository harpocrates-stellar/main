        "timestamp": "2026-09-25T06:37:59.964697Z",
        "nullifier": "efefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefef",
        "revocationStatus": "revoked"
      },
      "expect": {
        "reject_code": "nullifier_revoked",
