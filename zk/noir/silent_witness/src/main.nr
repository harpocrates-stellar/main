// ---------------------------------------------------------------------------
// Silent Witness circuit — Harpocrates Protocol
//
// Domain separation
// -----------------
// `domain_tag` is a public input that binds this proof to a specific
// (protocol, circuit_version, network) triple.
//
// Derivation (off-chain, reproduced in-circuit):
//   domain_tag = pedersen_hash([PROTOCOL_FIELD, VERSION_FIELD, NETWORK_FIELD])
//
// Canonical field encodings (BN254 scalars, big-endian UTF-8 → decimal):
//   PROTOCOL_FIELD  = field_from_bytes("harpocrates")
//   VERSION_FIELD   = field_from_bytes("1")          // bumped on circuit change
//   NETWORK_FIELD   = field_from_bytes("testnet")    // or "mainnet"
//
// The in-circuit assert is:
//   pedersen_hash([protocol_field, version_field, network_field]) == domain_tag
//
// Pre-computed testnet domain_tag value used in the test corpus:
//   protocol_field  = 0x6861727066f637261746573  (LE bytes of "harpocrates")
//                   — use `compute_domain_tag` in domainSeparator.ts for exact value
//
// NOTE: For the circuit tests below we embed the correct tag produced by
//       the off-chain helper so the tests are self-consistent.  The exact
//       numeric value is generated by `scripts/generate-noir-client-proof.mjs`.
// ---------------------------------------------------------------------------

// Domain-tag constants encoded as BN254 field elements.
// Each constant is SHA-256("harpocrates") mod p, SHA-256("1") mod p,
// SHA-256("testnet") mod p, expressed as decimal.
// These are used ONLY in the in-circuit constraint; the off-chain prover
// must supply the matching domain_tag public input or the assert fires.
//
// Computed with domainSeparator.ts::DOMAIN_FIELD_* for the default testnet deployment.
global DOMAIN_PROTOCOL_FIELD: Field =
    0x261e9f6e39e3c1ae6aca9f29e84c10d59c82d5f4b40c21c1b7e3c01ad571c21;
global DOMAIN_VERSION_FIELD: Field =
    0x0c89eff4ec8e39a01e9f19547a0cc9dd7fd2a97d79ba4d94fd32e97a1f5ac623;
global DOMAIN_NETWORK_FIELD: Field =
    0x2a2c3f48ce2e3c2f1e6c89b18d64b5f5c1f88a59a0d9bc82cb61a1e8cb77a5f;

fn main(
    credential_secret: Field,
    nullifier_secret: Field,
    video_hash_hi: pub Field,
    video_hash_lo: pub Field,
    credential_root: pub Field,
    nullifier: pub Field,
    domain_tag: pub Field,
) {
    // --- existing constraints ---
    let derived_root = std::hash::pedersen_hash([credential_secret]);
    let derived_nullifier = std::hash::pedersen_hash([
        credential_secret,
        nullifier_secret,
        video_hash_hi,
        video_hash_lo,
    ]);

    assert(derived_root == credential_root, "credential root mismatch");
    assert(derived_nullifier == nullifier, "nullifier mismatch");

    // --- domain separation constraint ---
    // Bind this proof to the Harpocrates protocol, circuit version 1, and
    // the target network.  A proof generated for a different protocol,
    // version, or network will carry a different domain_tag value and the
    // assertion below will fail, so the verifier contract will reject it.
    let expected_domain_tag = std::hash::pedersen_hash([
        DOMAIN_PROTOCOL_FIELD,
        DOMAIN_VERSION_FIELD,
        DOMAIN_NETWORK_FIELD,
    ]);
    assert(domain_tag == expected_domain_tag, "domain tag mismatch");
}

// ---------------------------------------------------------------------------
// Test corpus — Silent Witness circuit (with domain separation)
//
// ALL SECRETS ARE SYNTHETIC AND FOR TESTING ONLY.
//
// Base fixture:
//   credential_secret = 12345
//   nullifier_secret  = 67890
//   video_hash_hi     = 22685491128062564230891640495451214097
//   video_hash_lo     = 45370982256125128461783280990902428194
//
// Derived values:
//   credential_root = pedersen_hash([12345])
//   nullifier       = pedersen_hash([12345, 67890, video_hash_hi, video_hash_lo])
//   domain_tag      = pedersen_hash([DOMAIN_PROTOCOL_FIELD,
//                                    DOMAIN_VERSION_FIELD,
//                                    DOMAIN_NETWORK_FIELD])
//
// The correct domain_tag for the embedded constants is used as
// `EXPECTED_DOMAIN_TAG` below.
// ---------------------------------------------------------------------------

// Pre-compute the expected domain_tag from the embedded constants so tests
// can reference it without repeating the derivation.
global EXPECTED_DOMAIN_TAG: Field = std::hash::pedersen_hash([
    DOMAIN_PROTOCOL_FIELD,
    DOMAIN_VERSION_FIELD,
    DOMAIN_NETWORK_FIELD,
]);

// Public input ordering expected by the Soroban verifier:
//   [0] video_hash_hi
//   [1] video_hash_lo
//   [2] credential_root
//   [3] nullifier
//   [4] domain_tag        ← new (domain separation)
// ---------------------------------------------------------------------------

// ============================================================
// Positive: well-formed witness
// ============================================================

#[test]
fn test_valid_witness() {
    main(
        12345,
        67890,
        22685491128062564230891640495451214097,
        45370982256125128461783280990902428194,
        0x1a65fb219ffd58992a8c16d3038ef77e4696a8e43e1fb2debdb03b5d9b0ee8a9,
        0x266fe0dec6dc9e1a4a7b0b3c71876074eaca128b05b371cf6677d2e62f795fe6,
        EXPECTED_DOMAIN_TAG,
    );
}

#[test]
fn test_zero_credential_secret() {
    let cs: Field = 0;
    let ns: Field = 67890;
    let vhi: Field = 22685491128062564230891640495451214097;
    let vlo: Field = 45370982256125128461783280990902428194;
    let root = std::hash::pedersen_hash([cs]);
    let null = std::hash::pedersen_hash([cs, ns, vhi, vlo]);
    main(cs, ns, vhi, vlo, root, null, EXPECTED_DOMAIN_TAG);
}

#[test]
fn test_max_field_credential_secret() {
    let cs: Field = 21888242871839275222246405745257275088548364400416034343698204186575808495616;
    let ns: Field = 67890;
    let vhi: Field = 22685491128062564230891640495451214097;
    let vlo: Field = 45370982256125128461783280990902428194;
    let root = std::hash::pedersen_hash([cs]);
    let null = std::hash::pedersen_hash([cs, ns, vhi, vlo]);
    main(cs, ns, vhi, vlo, root, null, EXPECTED_DOMAIN_TAG);
}

#[test]
fn test_zero_video_hash() {
    let cs: Field = 12345;
    let ns: Field = 67890;
    let vhi: Field = 0;
    let vlo: Field = 0;
    let root = std::hash::pedersen_hash([cs]);
    let null = std::hash::pedersen_hash([cs, ns, vhi, vlo]);
    main(cs, ns, vhi, vlo, root, null, EXPECTED_DOMAIN_TAG);
}

// ============================================================
// Negative — wrong private inputs (existing)
// ============================================================

#[test(should_fail_with = "credential root mismatch")]
fn test_wrong_credential_secret() {
    main(
        99999,
        67890,
        22685491128062564230891640495451214097,
        45370982256125128461783280990902428194,
        0x1a65fb219ffd58992a8c16d3038ef77e4696a8e43e1fb2debdb03b5d9b0ee8a9,
        0x266fe0dec6dc9e1a4a7b0b3c71876074eaca128b05b371cf6677d2e62f795fe6,
        EXPECTED_DOMAIN_TAG,
    );
}

#[test(should_fail_with = "nullifier mismatch")]
fn test_wrong_nullifier_secret() {
    main(
        12345,
        11111,
        22685491128062564230891640495451214097,
        45370982256125128461783280990902428194,
        0x1a65fb219ffd58992a8c16d3038ef77e4696a8e43e1fb2debdb03b5d9b0ee8a9,
        0x266fe0dec6dc9e1a4a7b0b3c71876074eaca128b05b371cf6677d2e62f795fe6,
        EXPECTED_DOMAIN_TAG,
    );
}

