// ============================================================
// Negative — domain tag mismatch (NEW: domain separation tests)
// ============================================================

// Zero domain_tag — never equals the expected Pedersen hash.
#[test(should_fail_with = "domain tag mismatch")]
fn test_zero_domain_tag_rejected() {
    main(
        12345,
        67890,
        22685491128062564230891640495451214097,
        45370982256125128461783280990902428194,
        0x1a65fb219ffd58992a8c16d3038ef77e4696a8e43e1fb2debdb03b5d9b0ee8a9,
        0x266fe0dec6dc9e1a4a7b0b3c71876074eaca128b05b371cf6677d2e62f795fe6,
        0, // wrong — zero is not the Pedersen hash of the domain constants
    );
}

// Wrong protocol constant — simulates a proof from a different protocol.
#[test(should_fail_with = "domain tag mismatch")]
fn test_wrong_protocol_domain_tag_rejected() {
    // Compute a tag using a different protocol constant (99 ≠ DOMAIN_PROTOCOL_FIELD)
    let wrong_tag = std::hash::pedersen_hash([99, DOMAIN_VERSION_FIELD, DOMAIN_NETWORK_FIELD]);
    main(
        12345,
        67890,
        22685491128062564230891640495451214097,
        45370982256125128461783280990902428194,
        0x1a65fb219ffd58992a8c16d3038ef77e4696a8e43e1fb2debdb03b5d9b0ee8a9,
        0x266fe0dec6dc9e1a4a7b0b3c71876074eaca128b05b371cf6677d2e62f795fe6,
        wrong_tag,
    );
}

// Wrong version constant — simulates a proof for an older/newer circuit.
#[test(should_fail_with = "domain tag mismatch")]
fn test_wrong_version_domain_tag_rejected() {
    let wrong_tag = std::hash::pedersen_hash([DOMAIN_PROTOCOL_FIELD, 999, DOMAIN_NETWORK_FIELD]);
    main(
        12345,
        67890,
        22685491128062564230891640495451214097,
        45370982256125128461783280990902428194,
        0x1a65fb219ffd58992a8c16d3038ef77e4696a8e43e1fb2debdb03b5d9b0ee8a9,
        0x266fe0dec6dc9e1a4a7b0b3c71876074eaca128b05b371cf6677d2e62f795fe6,
        wrong_tag,
    );
}

// Wrong network constant — simulates a testnet proof replayed on mainnet verifier
// (or vice versa).
#[test(should_fail_with = "domain tag mismatch")]
fn test_wrong_network_domain_tag_rejected() {
    let wrong_tag = std::hash::pedersen_hash([DOMAIN_PROTOCOL_FIELD, DOMAIN_VERSION_FIELD, 42]);
    main(
        12345,
        67890,
        22685491128062564230891640495451214097,
        45370982256125128461783280990902428194,
        0x1a65fb219ffd58992a8c16d3038ef77e4696a8e43e1fb2debdb03b5d9b0ee8a9,
        0x266fe0dec6dc9e1a4a7b0b3c71876074eaca128b05b371cf6677d2e62f795fe6,
        wrong_tag,
    );
}

// All three domain constants wrong simultaneously.
#[test(should_fail_with = "domain tag mismatch")]
fn test_all_domain_constants_wrong_rejected() {
    let wrong_tag = std::hash::pedersen_hash([1, 2, 3]);
    main(
        12345,
        67890,
        22685491128062564230891640495451214097,
        45370982256125128461783280990902428194,
        0x1a65fb219ffd58992a8c16d3038ef77e4696a8e43e1fb2debdb03b5d9b0ee8a9,
        0x266fe0dec6dc9e1a4a7b0b3c71876074eaca128b05b371cf6677d2e62f795fe6,
        wrong_tag,
    );
}
